{
  "name": "zombie-invasion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:playcanvas": "vite --open /playcanvas.html",
    "build": "vite build",
    "vercel-build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "generate:music": "node scripts/generate-retro-music.mjs",
    "test": "vitest run",
    "test:unit": "npm test",
    "test:build": "npm run build",
    "test:smoke": "npm run smoke:playcanvas",
    "test:legacy": "npm run smoke:legacy",
    "validate": "node scripts/validate-project.mjs",
    "validate:dist": "node scripts/validate-project.mjs --dist",
    "verify": "npm run validate && npm run test:unit && npm run test:build && npm run validate:dist && npm run test:smoke",
    "test:full": "npm run verify",
    "test:watch": "vitest",
    "test:game": "node \"$WEB_GAME_CLIENT\" --url http://127.0.0.1:5173 --actions-file \"$WEB_GAME_ACTIONS\" --iterations 2 --pause-ms 250",
    "smoke:playcanvas": "node scripts/smoke-playcanvas-slice.mjs",
    "smoke:legacy": "node scripts/smoke-legacy-route.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "lucide": "^1.8.0",
    "playcanvas": "^2.19.1",
    "three": "^0.183.1"
  },
  "devDependencies": {
    "jsdom": "^28.1.0",
    "playwright": "^1.55.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "22.x"
  }
}
